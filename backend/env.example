# خادم API. ضع القيم الحقيقية في EasyPanel فقط، ولا ترفع ملفاً يحتوي أسراراً.
# DATABASE_URL الداخلي على شبكة EasyPanel (استبدل المستخدم وكلمة المرور في اللوحة):
# postgres://USER:PASSWORD@sahraaaaaaaaaaa_database:5432/sahraaaaaaaaaaa?sslmode=disable

NODE_ENV=production
PORT=4000
DATABASE_URL=
FRONTEND_ORIGIN=https://sahraaaaaaaaaaa.shop
PUBLIC_APP_URL=https://sahraaaaaaaaaaa.shop

JWT_SECRET=
JWT_REFRESH_SECRET=
SHEETS_SYNC_ENABLED=true
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SHARED_SECRET=

# CAPI. الخادم فقط. لا تضعها في الواجهة.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
SNAP_TEST_EVENT_CODE=

REDIS_URL=

# حماية الطلبات. السعودية فقط. لا تضع مفاتيح MaxMind في Git.
FRAUD_GUARD_ENABLED=true
FRAUD_PURCHASE_REQUIRES_CONFIRMATION=true
FRAUD_PHONE_WINDOW_MINUTES=15
FRAUD_PHONE_MAX=2
FRAUD_ORDER_RATE_MAX=8
FRAUD_ORDER_RATE_WINDOW_MS=600000
FRAUD_MEDIUM_CAN_SELF_CONFIRM=true
FRAUD_OTP_ENABLED=false
FRAUD_OTP_WEBHOOK_URL=
FRAUD_OTP_TTL_SECONDS=300
GEOIP_SA_ONLY=true
GEOIP_FOREIGN_ACTION=review
GEOIP_UNKNOWN_ACTION=allow
GEOIP_TRUST_CLOUDFLARE=false
TRUST_PROXY=true
GEOIP_CACHE_TTL_MS=21600000
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=
